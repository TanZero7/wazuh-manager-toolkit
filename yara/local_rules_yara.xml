<!--
  -  YARA integration rules
  -  ID range: 100700-100701 (avoid Wazuh's reserved <100000; pick a range
  -  that doesn't collide with any other custom rules file you already have)
-->
<group name="wazuhkit,yara,">

  <rule id="100700" level="12">
    <decoded_as>json</decoded_as>
    <field name="integration">yara</field>
    <!-- [fix] Must be "\.+", NOT ".+". Wazuh's <field> uses OS_Regex by
         default, where "\." means ANY character and a bare "." is a LITERAL
         dot. "\.+" = "field has a non-empty value" (the same idiom the
         Suricata rules use). An earlier "fix" changed this to ".+", which only
         matches a value made of literal dots; YARA rule names can't contain
         dots, so 100700 could never fire. install-manager-rules.sh's
         wazuh-logtest check (logtest-samples/yara-match.json) catches this:
         expect "[ OK ] yara-match.json -> rule 100700". -->
    <field name="yara_rule">\.+</field>
    <description>YARA: rule $(yara_rule) matched on $(yara_scanned_file)</description>
    <mitre>
      <id>T1204.002</id>
      <id>T1059</id>
    </mitre>
    <group>yara_alert,gpg13_4.2,</group>
  </rule>

  <rule id="100701" level="3">
    <decoded_as>json</decoded_as>
    <field name="integration">yara</field>
    <field name="yara_scan_result">^clean$</field>
    <description>YARA: $(yara_scanned_file) scanned, no match</description>
    <group>yara_scan,</group>
  </rule>

</group>
